{
  "productName": "DzWire Terminal",
  "version": "1.0.0",
  "identifier": "com.dzwire.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "DzWire Macro Intelligence Terminal",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://dzwire-news.vercel.app ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["all"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
